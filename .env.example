# 📝 Archivo de Ejemplo de Variables de Entorno
# Copia este archivo a .env y completa los valores con tus credenciales.

# --- Twilio (WhatsApp) ---
TWILIO_ACCOUNT_SID=your_twilio_account_sid
TWILIO_AUTH_TOKEN=your_twilio_auth_token
TWILIO_WHATSAPP_NUMBER=whatsapp:+14155238886

# --- Google Cloud Platform (GCP) ---
GOOGLE_CLOUD_PROJECT=your_gcp_project_id
REGION=us-central1

# --- LLM API Keys (elige al menos una) ---
# Mistral API (recomendado por bajo costo)
MISTRAL_API_KEY=your_mistral_api_key

# OpenRouter API (alternativa)
OPENROUTER_API_KEY=your_openrouter_api_key

# Gemini API (Google)
GEMINI_API_KEY=your_gemini_api_key

# --- Configuración del LLM ---
LLM_MODEL=mistral-tiny
LLM_TEMPERATURE=0.7
LLM_MAX_TOKENS=200

# --- Logging ---
LOG_LEVEL=INFO

# --- Monitoreo ---
MAX_COST_PER_MONTH=50
ALERT_THRESHOLD=40

# --- Escalamiento a Humanos (opcional) ---
# Email
SMTP_SERVER=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASSWORD=your_email_password
SUPPORT_EMAIL=soporte@tuempresa.com

# Slack
SLACK_WEBHOOK_URL=https://hooks.slack.com/services/...

# --- Firestore (opcional, si quieres sobrescribir config.yaml) ---
FIRESTORE_COLLECTION_KNOWLEDGE=knowledge_base
FIRESTORE_COLLECTION_PRODUCTS=products
FIRESTORE_COLLECTION_FAQ=faq
FIRESTORE_COLLECTION_SESSIONS=chat_sessions
