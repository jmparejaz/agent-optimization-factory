# 📝 .gitignore para el Agente de WhatsApp
# Este archivo especifica qué archivos y directorios deben ser ignorados por Git.

# --- Entorno ---
.env
.env.local
.env.*.local

# --- Python ---
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg

# --- Virtual Environments ---
venv/
ENV/
env/
.venv/

# --- IDE ---
.idea/
.vscode/
*.swp
*.swo
*~

# --- OS ---
.DS_Store
Thumbs.db

# --- Logs ---
*.log
logs/

# --- Configuración local ---
config.local.yaml
config.*.local.yaml

# --- Credenciales de GCP ---
*.json
service-account.json
key.json

# --- Docker ---
.docker/

# --- Cloud Run ---
.gcloud/

# --- Firestore ---
# Ignorar datos de prueba locales (si los hay)
local_firestore/

# --- Temporary Files ---
*.tmp
*.temp
.cache/
